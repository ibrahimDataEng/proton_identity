# HTTP port this service listens on
PORT=5001

# Postgres — same instance/credentials as saleor_platform/backend.env.
# In Docker (shared network) this becomes: postgres://saleor:saleor@db:5432/saleor
DATABASE_URL=postgres://saleor:saleor@localhost:5432/saleor

# Shared secret every caller must send as "Authorization: Bearer <SERVICE_TOKEN>".
# Every route except /health rejects requests (503, "service not configured") until
# this is set. Generate a real value before deploying: openssl rand -hex 32
SERVICE_TOKEN=
